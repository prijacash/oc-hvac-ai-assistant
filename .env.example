# Chat model. Use a provider/model id from the live catalog:
# https://ai-gateway.vercel.sh/v1/models
# The default in code is openai/gpt-5.4-mini (tool calling, lower cost than a flagship).
AI_MODEL=openai/gpt-5.4-mini

# Embedding model used to retrieve knowledge-base chunks.
# The default in code is openai/text-embedding-3-small.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Preferred auth: Vercel AI Gateway.
# On Vercel, a project OIDC token can be used instead of this key.
AI_GATEWAY_API_KEY=

# Direct OpenAI. Used only when no gateway key and no Vercel OIDC token are set.
# Model ids above may include an "openai/" prefix; the app strips it for this path.
OPENAI_API_KEY=
